{
    "name": "auto-cert-root",
    "private": true,
    "license": "MIT",
    "workspaces": [
        "apps/*"
    ],
    "author": "Kuba Góra",
    "scripts": {
        "web-app:start": "yarn workspace auto-cert-web dev",
        "web-app:build": "yarn workspace auto-cert-web build",
        "web-app:preview": "yarn workspace auto-cert-web preview",
        "web-app:test": "yarn workspace auto-cert-web test",
        "web-app:e2e": "yarn workspace auto-cert-web test:e2e",
        "backend:start": "dotnet run --project apps/backend/AutoCert.Backend",
        "backend:build": "dotnet build apps/backend/AutoCert.Backend",
        "backend:test": "dotnet test apps/backend/AutoCert.Tests",
        "start": "concurrently \"yarn web-app:start\" \"yarn backend:run\""
    },
    "devDependencies": {
        "concurrently": "9.1.2"
    }
}